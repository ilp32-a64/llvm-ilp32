diff --git a/clang/lib/Basic/Targets/AArch64.cpp b/clang/lib/Basic/Targets/AArch64.cpp
index c0cc4db83..d30e3f020 100644
--- a/clang/lib/Basic/Targets/AArch64.cpp
+++ b/clang/lib/Basic/Targets/AArch64.cpp
@@ -135,7 +135,7 @@ AArch64TargetInfo::AArch64TargetInfo(const llvm::Triple &Triple,
     if (!getTriple().isOSDarwin() && !getTriple().isOSNetBSD())
       WCharType = UnsignedInt;
 
-    if (getTriple().getEnvironment() == llvm::Triple::GNUILP32) {
+    if (getTriple().isILP32Environment()) {
       // Match GCC -mabi=ilp32: long is 32-bit, int64_t is long long and
       // intptr_t is int.
       Int64Type = SignedLongLong;
@@ -155,8 +155,7 @@ AArch64TargetInfo::AArch64TargetInfo(const llvm::Triple &Triple,
   HasFloat16 = true;
   HasStrictFP = true;
 
-  if (Triple.isArch64Bit() &&
-      getTriple().getEnvironment() != llvm::Triple::GNUILP32)
+  if (Triple.isArch64Bit() && !getTriple().isILP32Environment())
     LongWidth = LongAlign = PointerWidth = PointerAlign = 64;
   else
     LongWidth = LongAlign = PointerWidth = PointerAlign = 32;
diff --git a/clang/lib/Driver/Driver.cpp b/clang/lib/Driver/Driver.cpp
index 461b2190e..390220ba6 100644
--- a/clang/lib/Driver/Driver.cpp
+++ b/clang/lib/Driver/Driver.cpp
@@ -791,19 +791,23 @@ static llvm::Triple computeTargetTriple(const Driver &D,
     }
   }
 
-  // If target is AArch64 GNU/Linux adjust the target triple according to the
-  // provided ABI name, as GCC does for -mabi=ilp32 and -mabi=lp64.
+  // If target is AArch64 Linux (glibc or musl) adjust the target triple
+  // according to the provided ABI name, as GCC does for -mabi=ilp32 and
+  // -mabi=lp64.
   if ((Target.getArch() == llvm::Triple::aarch64 ||
        Target.getArch() == llvm::Triple::aarch64_be) &&
       Target.isOSLinux()) {
     if ((A = Args.getLastArgNoClaim(options::OPT_mabi_EQ))) {
       StringRef ABIName = A->getValue();
-      if (ABIName == "ilp32" &&
-          Target.getEnvironment() == llvm::Triple::GNU)
+      llvm::Triple::EnvironmentType Env = Target.getEnvironment();
+      if (ABIName == "ilp32" && Env == llvm::Triple::GNU)
         Target.setEnvironment(llvm::Triple::GNUILP32);
-      else if (ABIName == "lp64" &&
-               Target.getEnvironment() == llvm::Triple::GNUILP32)
+      else if (ABIName == "ilp32" && Env == llvm::Triple::Musl)
+        Target.setEnvironment(llvm::Triple::MuslILP32);
+      else if (ABIName == "lp64" && Env == llvm::Triple::GNUILP32)
         Target.setEnvironment(llvm::Triple::GNU);
+      else if (ABIName == "lp64" && Env == llvm::Triple::MuslILP32)
+        Target.setEnvironment(llvm::Triple::Musl);
     }
   }
 
