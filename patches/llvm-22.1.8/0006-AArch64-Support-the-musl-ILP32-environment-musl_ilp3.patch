--- a/llvm/include/llvm/TargetParser/Triple.h
+++ b/llvm/include/llvm/TargetParser/Triple.h
@@ -282,6 +282,7 @@ public:
     MuslF32,
     MuslSF,
     MuslX32,
+    MuslILP32,
     MuslWALI,
     LLVM,
 
@@ -867,6 +868,7 @@ public:
            getEnvironment() == Triple::MuslF32 ||
            getEnvironment() == Triple::MuslSF ||
            getEnvironment() == Triple::MuslX32 ||
+           getEnvironment() == Triple::MuslILP32 ||
            getEnvironment() == Triple::MuslWALI ||
            getEnvironment() == Triple::OpenHOS || isOSLiteOS();
   }
@@ -1041,8 +1043,7 @@ public:
     assert(PointerWidth == 64 || PointerWidth == 32);
     if (!isAArch64())
       return false;
-    return getArch() == Triple::aarch64_32 ||
-                   getEnvironment() == Triple::GNUILP32
+    return getArch() == Triple::aarch64_32 || isILP32Environment()
                ? PointerWidth == 32
                : PointerWidth == 64;
   }
@@ -1177,6 +1178,13 @@ public:
     return Env == Triple::GNUX32 || Env == Triple::MuslX32;
   }
 
+  /// Tests whether the target uses the AArch64 Linux ILP32 ABI (32-bit long
+  /// and pointers, as GCC's -mabi=ilp32), with glibc or musl.
+  bool isILP32Environment() const {
+    EnvironmentType Env = getEnvironment();
+    return Env == Triple::GNUILP32 || Env == Triple::MuslILP32;
+  }
+
   /// Tests whether the target is eBPF.
   bool isBPF() const {
     return getArch() == Triple::bpfel || getArch() == Triple::bpfeb;
