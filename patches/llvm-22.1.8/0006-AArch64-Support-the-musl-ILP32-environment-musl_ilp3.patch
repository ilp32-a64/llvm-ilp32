diff --git a/llvm/lib/Target/AArch64/AArch64Subtarget.h b/llvm/lib/Target/AArch64/AArch64Subtarget.h
index 389b6b69b..e3f735e41 100644
--- a/llvm/lib/Target/AArch64/AArch64Subtarget.h
+++ b/llvm/lib/Target/AArch64/AArch64Subtarget.h
@@ -316,16 +316,14 @@ public:
   bool isTargetMachO() const { return TargetTriple.isOSBinFormatMachO(); }
 
   bool isTargetILP32() const {
-    return TargetTriple.isArch32Bit() ||
-           TargetTriple.getEnvironment() == Triple::GNUILP32;
+    return TargetTriple.isArch32Bit() || TargetTriple.isILP32Environment();
   }
 
-  /// GNU ILP32 follows AAPCS64: the upper 32 bits of a pointer passed or
-  /// returned in a 64-bit register (or 8-byte stack slot) are unspecified and
-  /// the receiver zero-extends it. arm64_32 has the producer do that instead.
-  bool isTargetGNUILP32() const {
-    return TargetTriple.getEnvironment() == Triple::GNUILP32;
-  }
+  /// The GNU ILP32 ABI (aarch64-*-linux-gnu_ilp32 and -musl_ilp32) follows
+  /// AAPCS64: the upper 32 bits of a pointer passed or returned in a 64-bit
+  /// register (or 8-byte stack slot) are unspecified and the receiver
+  /// zero-extends it. arm64_32 has the producer do that instead.
+  bool isTargetGNUILP32() const { return TargetTriple.isILP32Environment(); }
 
   bool useAA() const override;
 
