+// Check the driver support for the AArch64 ILP32 ABI with musl, laid out like an
+// OpenWrt aarch64-openwrt-linux-musl_ilp32 GCC toolchain (libraries in lib).
+
+// RUN: %clang -### %s --target=aarch64-openwrt-linux-musl_ilp32 -no-pie \
+// RUN:     --gcc-toolchain=%S/Inputs/aarch64_openwrt_musl_ilp32_tree \
+// RUN:     --sysroot=%S/Inputs/aarch64_openwrt_musl_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32
+// RUN: %clang -### %s --target=aarch64-openwrt-linux-musl -mabi=ilp32 -no-pie \
+// RUN:     --gcc-toolchain=%S/Inputs/aarch64_openwrt_musl_ilp32_tree \
+// RUN:     --sysroot=%S/Inputs/aarch64_openwrt_musl_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32
+// ILP32: "-cc1" "-triple" "aarch64-openwrt-linux-musl_ilp32"
+// ILP32-SAME: "-target-abi" "aapcs"
+// ILP32: "--sysroot=[[SYSROOT:[^"]+]]"
+// ILP32-SAME: "-m" "aarch64linux32"
+// ILP32-SAME: "-dynamic-linker" "/lib/ld-musl-aarch64_ilp32.so.1"
+// ILP32-SAME: "[[SYSROOT]]/lib{{/|\\\\}}crt1.o"
+// ILP32-SAME: "[[SYSROOT]]/lib/gcc/aarch64-openwrt-linux-musl_ilp32/14.3.0{{/|\\\\}}crtbegin.o"
+// ILP32-SAME: "-L[[SYSROOT]]/lib/gcc/aarch64-openwrt-linux-musl_ilp32/14.3.0"
+// ILP32-SAME: "-L[[SYSROOT]]/lib"
+
+// RUN: %clang -### %s --target=aarch64_be-openwrt-linux-musl_ilp32 -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_openwrt_musl_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32BE
+// ILP32BE: "-cc1" "-triple" "aarch64_be-openwrt-linux-musl_ilp32"
+// ILP32BE: "-m" "aarch64linux32b"
+// ILP32BE-SAME: "-dynamic-linker" "/lib/ld-musl-aarch64_be_ilp32.so.1"
+
+// -mabi=lp64 selects the LP64 ABI again.
+// RUN: %clang -### %s --target=aarch64-openwrt-linux-musl_ilp32 -mabi=lp64 -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_openwrt_musl_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=LP64
+// LP64: "-cc1" "-triple" "aarch64-openwrt-linux-musl"
+// LP64: "-m" "aarch64linux"
+// LP64-SAME: "-dynamic-linker" "/lib/ld-musl-aarch64.so.1"
