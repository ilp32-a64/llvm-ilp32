From 73fe8dbf6813bcce0f2fd91c0b4d530560693d1e Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Thu, 22 Oct 2026 05:57:58 +0800
Subject: [PATCH 05/11] [AArch64] GNU ILP32: no pointer extension for LLVM-only
 calling conventions

The receiver has to zero-extend GNU ILP32 pointers only because GCC-compiled
code may be on the other side of the call. GCC implements none of LLVM's own
calling conventions for AArch64 (it ignores preserve_none, preserve_most and
preserve_all, and has no fastcc, tailcc, coldcc, GHC or Swift conventions),
so pointers passed or returned with them always come from LLVM-compiled code,
which keeps them zero-extended. Assert the zero extension for these
conventions as for arm64_32. The vector and SVE PCS, which GCC supports,
keep the extension.

This matters for CPython 3.14's tail-calling interpreter: its opcode
handlers use preserve_none, are called through a dispatch table (so their
address is taken) and each received four pointers. On ceval.c this removes
685 of 693 "mov wN, wN" instructions from the 231 handlers (16934 instead of
17854 instructions).

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
---
 .../Target/AArch64/AArch64ISelLowering.cpp    |  28 ++-
 .../AArch64/ilp32-gnu-pointer-extend.ll       | 228 ++++++++++++++++++
 2 files changed, 253 insertions(+), 3 deletions(-)

diff --git a/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp b/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
index c2ea4305e..ccfaab579 100644
--- a/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
+++ b/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
@@ -8535,6 +8535,27 @@ static bool hasOnlyLocalCallers(const Function &F) {
   return F.hasLocalLinkage() && !F.hasAddressTaken();
 }
 
+/// Whether GCC-compiled code can be on the other side of a call with this
+/// calling convention. GCC implements none of LLVM's own conventions for
+/// AArch64 (it ignores preserve_none, preserve_most and preserve_all), so
+/// pointers passed or returned with them always come from LLVM-compiled code.
+static bool mayInteroperateWithGCC(CallingConv::ID CC) {
+  switch (CC) {
+  case CallingConv::Fast:
+  case CallingConv::Cold:
+  case CallingConv::GHC:
+  case CallingConv::Tail:
+  case CallingConv::PreserveMost:
+  case CallingConv::PreserveAll:
+  case CallingConv::PreserveNone:
+  case CallingConv::Swift:
+  case CallingConv::SwiftTail:
+    return false;
+  default:
+    return true;
+  }
+}
+
 SDValue AArch64TargetLowering::LowerFormalArguments(
     SDValue Chain, CallingConv::ID CallConv, bool isVarArg,
     const SmallVectorImpl<ISD::InputArg> &Ins, const SDLoc &DL,
@@ -8807,7 +8828,7 @@ SDValue AArch64TargetLowering::LowerFormalArguments(
       }
     } else {
       if (Subtarget->isTargetGNUILP32() && Ins[i].Flags.isPointer() &&
-          !hasOnlyLocalCallers(F))
+          mayInteroperateWithGCC(CallConv) && !hasOnlyLocalCallers(F))
         ArgValue = DAG.getZeroExtendInReg(ArgValue, DL, MVT::i32);
       else if (Subtarget->isTargetILP32() && Ins[i].Flags.isPointer())
         ArgValue = DAG.getNode(ISD::AssertZext, DL, ArgValue.getValueType(),
@@ -10381,9 +10402,10 @@ AArch64TargetLowering::LowerCall(CallLoweringInfo &CLI,
       IsThisReturn ? OutVals[0] : SDValue(), RequiresSMChange);
 
   // A GNU ILP32 callee may return a pointer with garbage in the upper 32 bits,
-  // unless it is a local function compiled here.
+  // unless it is a local function compiled here or uses a calling convention
+  // that GCC does not implement.
   const Function *CalledFn = CLI.CB ? CLI.CB->getCalledFunction() : nullptr;
-  if (Subtarget->isTargetGNUILP32() &&
+  if (Subtarget->isTargetGNUILP32() && mayInteroperateWithGCC(CallConv) &&
       !(CalledFn && CalledFn->hasLocalLinkage() &&
         !CalledFn->isDeclaration())) {
     assert(InVals.size() == Ins.size() && "unexpected call result split");
diff --git a/llvm/test/CodeGen/AArch64/ilp32-gnu-pointer-extend.ll b/llvm/test/CodeGen/AArch64/ilp32-gnu-pointer-extend.ll
