+; GCC implements none of these calling conventions for AArch64, so only
+; LLVM-compiled code, which zero-extends pointers, passes or returns pointers
+; with them: no extension, even with external linkage.
+define preserve_nonecc i32 @preserve_none_deref(ptr %p) {
+; GNU-LABEL: preserve_none_deref:
+; GNU:       // %bb.0:
+; GNU-NEXT:    ldr w0, [x20]
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: preserve_none_deref:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    ldr w0, [x20]
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: preserve_none_deref:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ldr w0, [x20]
+; DARWIN-NEXT:    ret
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+define preserve_mostcc i32 @preserve_most_deref(ptr %p) {
+; GNU-LABEL: preserve_most_deref:
+; GNU:       // %bb.0:
+; GNU-NEXT:    ldr w0, [x0]
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: preserve_most_deref:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    ldr w0, [x0]
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: preserve_most_deref:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ldr w0, [x0]
+; DARWIN-NEXT:    ret
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+define fastcc i32 @fast_deref(ptr %p) {
+; GNU-LABEL: fast_deref:
+; GNU:       // %bb.0:
+; GNU-NEXT:    ldr w0, [x0]
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: fast_deref:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    ldr w0, [x0]
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: fast_deref:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ldr w0, [x0]
+; DARWIN-NEXT:    ret
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+declare preserve_nonecc ptr @preserve_none_give()
