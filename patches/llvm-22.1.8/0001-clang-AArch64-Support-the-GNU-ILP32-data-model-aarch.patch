From 74b94a1ef9a870bc68c65bfc3fcb7509837d09b1 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Wed, 21 Oct 2026 21:41:23 +0800
Subject: [PATCH 01/10] [clang][AArch64] Support the GNU ILP32 data model
 (aarch64-*-gnu_ilp32)

The AArch64 back end supports the GNU ILP32 ABI since D94143, but the clang
front end still used the LP64 types for aarch64[_be]-*-gnu_ilp32, so its
pointer size disagreed with the data layout.

Use 32-bit long and pointers for the gnu_ilp32 environment, with the same
standard types as GCC -mabi=ilp32: int64_t and intmax_t are long long,
intptr_t is int, size_t and ptrdiff_t are (unsigned) long and wchar_t is
unsigned int. The data layout already comes from Triple::computeDataLayout.

Based on the unmerged review D104931. Unlike that patch, wchar_t keeps the
AArch64 GNU/Linux type (unsigned int) and intptr_t matches GCC.

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
---
 clang/lib/Basic/Targets/AArch64.cpp           | 15 ++++--
 .../test/CodeGen/AArch64/aarch64-gnu-ilp32.c  | 51 +++++++++++++++++++
 2 files changed, 63 insertions(+), 3 deletions(-)
 create mode 100644 clang/test/CodeGen/AArch64/aarch64-gnu-ilp32.c

diff --git a/clang/lib/Basic/Targets/AArch64.cpp b/clang/lib/Basic/Targets/AArch64.cpp
index d148705a3..c0cc4db83 100644
--- a/clang/lib/Basic/Targets/AArch64.cpp
+++ b/clang/lib/Basic/Targets/AArch64.cpp
@@ -135,8 +135,16 @@ AArch64TargetInfo::AArch64TargetInfo(const llvm::Triple &Triple,
     if (!getTriple().isOSDarwin() && !getTriple().isOSNetBSD())
       WCharType = UnsignedInt;
 
-    Int64Type = SignedLong;
-    IntMaxType = SignedLong;
+    if (getTriple().getEnvironment() == llvm::Triple::GNUILP32) {
+      // Match GCC -mabi=ilp32: long is 32-bit, int64_t is long long and
+      // intptr_t is int.
+      Int64Type = SignedLongLong;
+      IntMaxType = SignedLongLong;
+      IntPtrType = SignedInt;
+    } else {
+      Int64Type = SignedLong;
+      IntMaxType = SignedLong;
+    }
   }
 
   AddrSpaceMap = &ARM64AddrSpaceMap;
@@ -147,7 +155,8 @@ AArch64TargetInfo::AArch64TargetInfo(const llvm::Triple &Triple,
   HasFloat16 = true;
   HasStrictFP = true;
 
-  if (Triple.isArch64Bit())
+  if (Triple.isArch64Bit() &&
+      getTriple().getEnvironment() != llvm::Triple::GNUILP32)
     LongWidth = LongAlign = PointerWidth = PointerAlign = 64;
   else
     LongWidth = LongAlign = PointerWidth = PointerAlign = 32;
diff --git a/clang/test/CodeGen/AArch64/aarch64-gnu-ilp32.c b/clang/test/CodeGen/AArch64/aarch64-gnu-ilp32.c
new file mode 100644
index 000000000..b71b3f7c0
--- /dev/null
+++ b/clang/test/CodeGen/AArch64/aarch64-gnu-ilp32.c
@@ -0,0 +1,51 @@
+// RUN: %clang_cc1 -E -dM -ffreestanding -triple=aarch64-linux-gnu_ilp32 < /dev/null \
+// RUN:   | FileCheck --check-prefixes=CHECK,LE --implicit-check-not=_LP64 %s
+// RUN: %clang_cc1 -E -dM -ffreestanding -triple=aarch64_be-linux-gnu_ilp32 < /dev/null \
+// RUN:   | FileCheck --check-prefixes=CHECK,BE --implicit-check-not=_LP64 %s
+// RUN: %clang_cc1 -triple=aarch64-linux-gnu_ilp32 -emit-llvm -o - %s \
+// RUN:   | FileCheck --check-prefix=IR-LE %s
+// RUN: %clang_cc1 -triple=aarch64_be-linux-gnu_ilp32 -emit-llvm -o - %s \
+// RUN:   | FileCheck --check-prefix=IR-BE %s
+
+// The GNU ILP32 data model, as used by GCC with -mabi=ilp32: 32-bit long and
+// pointers, 64-bit long long, and the same types as GCC for the standard
+// typedefs.
+
+// CHECK-DAG: #define _ILP32 1
+// CHECK-DAG: #define __ILP32__ 1
+// CHECK-DAG: #define __aarch64__ 1
+// LE-DAG: #define __AARCH64EL__ 1
+// BE-DAG: #define __AARCH64EB__ 1
+// CHECK-DAG: #define __SIZEOF_POINTER__ 4
+// CHECK-DAG: #define __SIZEOF_LONG__ 4
+// CHECK-DAG: #define __SIZEOF_LONG_LONG__ 8
+// CHECK-DAG: #define __SIZEOF_LONG_DOUBLE__ 16
+// CHECK-DAG: #define __SIZEOF_SIZE_T__ 4
+// CHECK-DAG: #define __SIZEOF_PTRDIFF_T__ 4
+// CHECK-DAG: #define __SIZEOF_WCHAR_T__ 4
+// CHECK-DAG: #define __SIZE_TYPE__ long unsigned int
+// CHECK-DAG: #define __PTRDIFF_TYPE__ long int
+// CHECK-DAG: #define __INTPTR_TYPE__ int
+// CHECK-DAG: #define __UINTPTR_TYPE__ unsigned int
+// CHECK-DAG: #define __INT64_TYPE__ long long int
+// CHECK-DAG: #define __UINT64_TYPE__ long long unsigned int
+// CHECK-DAG: #define __INTMAX_TYPE__ long long int
+// CHECK-DAG: #define __UINTMAX_TYPE__ long long unsigned int
+// CHECK-DAG: #define __WCHAR_TYPE__ unsigned int
+// CHECK-DAG: #define __WINT_TYPE__ unsigned int
+// CHECK-DAG: #define __WCHAR_UNSIGNED__ 1
+// CHECK-DAG: #define __BIGGEST_ALIGNMENT__ 16
+// CHECK-DAG: #define __LONG_MAX__ 2147483647L
+// CHECK-DAG: #define __SIZE_MAX__ 4294967295UL
+
+// IR-LE: target datalayout = "e-m:e-p:32:32-
+// IR-LE: target triple = "aarch64-unknown-linux-gnu_ilp32"
+// IR-BE: target datalayout = "E-m:e-p:32:32-
+// IR-BE: target triple = "aarch64_be-unknown-linux-gnu_ilp32"
+
+// IR-LE: @p = global ptr null, align 4
+// IR-LE: @l = global i32 0, align 4
+// IR-LE: @ll = global i64 0, align 8
+void *p;
+long l;
+long long ll;
-- 
