From dc54ce757aec0c59fcac5c23b8300bff47ddb569 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:34:16 +0800
Subject: [PATCH 09/11] [SelectionDAG] Assert zero extension of pointers copied
 from other blocks

When the in-memory pointer type is narrower than the register type (32-bit
pointers in 64-bit registers: AArch64 ILP32 and arm64_32), pointer values in
the default address space are kept zero-extended in registers: loads,
arguments, call results, GEPs without inbounds and inttoptr all extend
them. Record this with an AssertZext when a pointer is read from a virtual
register defined in another block, so that the upper bits are not cleared
again. Not for inline assembly results, which may leave the upper bits
undefined, other address spaces (AArch64's 270 is sign-extended), or -O0.

The known zero extension of a loop's base pointer lets the following change
fold address offsets without extending the base in the loop.

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
---
 .../SelectionDAG/SelectionDAGBuilder.cpp      | 25 ++++++++
 .../SelectionDAG/SelectionDAGBuilder.h        |  2 +
 .../AArch64/ilp32-gnu-cross-block-pointer.ll  | 61 +++++++++++++++++++
 3 files changed, 88 insertions(+)
 create mode 100644 llvm/test/CodeGen/AArch64/ilp32-gnu-cross-block-pointer.ll

diff --git a/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp b/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp
index ac90cd9ed..70b4405b9 100644
--- a/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp
+++ b/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.cpp
@@ -1788,11 +1788,36 @@ SDValue SelectionDAGBuilder::getCopyFromRegs(const Value *V, Type *Ty) {
     Result = RFV.getCopyFromRegs(DAG, FuncInfo, getCurSDLoc(), Chain, nullptr,
                                  V);
     resolveDanglingDebugInfo(V, Result);
+    Result = assertPointerZeroExtended(V, Ty, Result);
   }
 
   return Result;
 }
 
+/// A pointer in the default address space whose memory type is narrower than
+/// its register type (32-bit pointers in 64-bit registers) is kept
+/// zero-extended in registers: loads, arguments, call results, non-inbounds
+/// GEPs and inttoptr all extend it. Record that for a pointer copied from
+/// another block. Inline assembly may leave the upper bits undefined; other
+/// address spaces may extend differently; at -O0 nothing would use it.
+SDValue SelectionDAGBuilder::assertPointerZeroExtended(const Value *V, Type *Ty,
+                                                      SDValue Val) {
+  if (!Val || !Ty->isPointerTy() || Ty->getPointerAddressSpace() != 0 ||
+      Val.getOpcode() == ISD::AssertZext || isa<ConstantSDNode>(Val) ||
+      DAG.getOptLevel() == CodeGenOptLevel::None)
+    return Val;
+  if (const auto *CB = dyn_cast<CallBase>(V); CB && CB->isInlineAsm())
+    return Val;
+  const TargetLowering &TLI = DAG.getTargetLoweringInfo();
+  EVT MemVT =
+      TLI.getPointerMemTy(DAG.getDataLayout(), Ty->getPointerAddressSpace());
+  EVT VT = Val.getValueType();
+  if (!VT.isScalarInteger() || !MemVT.isScalarInteger() || !MemVT.bitsLT(VT))
+    return Val;
+  return DAG.getNode(ISD::AssertZext, getCurSDLoc(), VT, Val,
+                     DAG.getValueType(MemVT));
+}
+
 /// getValue - Return an SDValue for the given Value.
 SDValue SelectionDAGBuilder::getValue(const Value *V) {
   // If we already have an SDValue for this value, use it. It's important
diff --git a/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.h b/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.h
index 6f3e7a63b..0500f1af9 100644
--- a/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.h
+++ b/llvm/lib/CodeGen/SelectionDAG/SelectionDAGBuilder.h
@@ -344,6 +344,8 @@ public:
   /// of the specified type Ty. Return empty SDValue() otherwise.
   SDValue getCopyFromRegs(const Value *V, Type *Ty);
 
+  SDValue assertPointerZeroExtended(const Value *V, Type *Ty, SDValue Val);
+
   /// Register a dbg_value which relies on a Value which we have not yet seen.
   void addDanglingDebugInfo(SmallVectorImpl<Value *> &Values,
                             DILocalVariable *Var, DIExpression *Expr,
diff --git a/llvm/test/CodeGen/AArch64/ilp32-gnu-cross-block-pointer.ll b/llvm/test/CodeGen/AArch64/ilp32-gnu-cross-block-pointer.ll
new file mode 100644
index 000000000..83f9afd7d
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/ilp32-gnu-cross-block-pointer.ll
@@ -0,0 +1,61 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
+; RUN: llc -mtriple=aarch64-linux-gnu_ilp32 < %s | FileCheck %s
+
+; 32-bit pointers are kept zero-extended in 64-bit registers. A pointer used in
+; a block other than the one that defines it is known to be zero-extended, so
+; that converting it to a 64-bit integer needs no instruction. Inline assembly
+; may leave the upper bits undefined.
+
+define i64 @arg_other_block(ptr %p, i1 %c) {
+; CHECK-LABEL: arg_other_block:
+; CHECK:       // %bb.0: // %entry
+; CHECK-NEXT:    mov w8, w0
+; CHECK-NEXT:    tst w1, #0x1
+; CHECK-NEXT:    csel x0, x8, xzr, ne
+; CHECK-NEXT:    ret
+entry:
+  br i1 %c, label %use, label %exit
+use:
+  %i = ptrtoint ptr %p to i64
+  ret i64 %i
+exit:
+  ret i64 0
+}
+
+define i64 @loaded_other_block(ptr %pp, i1 %c) {
+; CHECK-LABEL: loaded_other_block:
+; CHECK:       // %bb.0: // %entry
+; CHECK-NEXT:    mov w8, w0
+; CHECK-NEXT:    tst w1, #0x1
+; CHECK-NEXT:    ldr w8, [x8]
+; CHECK-NEXT:    csel x0, x8, xzr, ne
+; CHECK-NEXT:    ret
+entry:
+  %p = load ptr, ptr %pp
+  br i1 %c, label %use, label %exit
+use:
+  %i = ptrtoint ptr %p to i64
+  ret i64 %i
+exit:
+  ret i64 0
+}
+
+define i64 @asm_other_block(i1 %c) {
+; CHECK-LABEL: asm_other_block:
+; CHECK:       // %bb.0: // %entry
+; CHECK-NEXT:    //APP
+; CHECK-NEXT:    mov x8, #0 // =0x0
+; CHECK-NEXT:    //NO_APP
+; CHECK-NEXT:    tst w0, #0x1
+; CHECK-NEXT:    mov w8, w8
+; CHECK-NEXT:    csel x0, x8, xzr, ne
+; CHECK-NEXT:    ret
+entry:
+  %p = call ptr asm "mov $0, #0", "=r"()
+  br i1 %c, label %use, label %exit
+use:
+  %i = ptrtoint ptr %p to i64
+  ret i64 %i
+exit:
+  ret i64 0
+}
