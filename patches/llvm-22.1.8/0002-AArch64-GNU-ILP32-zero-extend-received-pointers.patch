From 920f5d31290644282f67bead55c90caeca52eac9 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Wed, 21 Oct 2026 21:50:37 +0800
Subject: [PATCH 2/4] [AArch64] GNU ILP32: zero-extend received pointers

arm64_32 has the producer of a pointer zero-extend it to 64 bits when it is
passed or returned in a register, and the same rule was applied to the GNU
ILP32 ABI. AAPCS64 and GCC -mabi=ilp32 work the other way round: the upper
32 bits of a pointer in an X register or an 8-byte stack slot are
unspecified. GCC does not clear them when it passes or returns a pointer
(it stores only 4 bytes for a stack argument) and zero-extends on receipt.

Code compiled by LLVM could therefore use garbage upper bits as part of an
address when called from GCC-compiled code, or when using a pointer
returned by it, e.g. a pointer converted from a 64-bit integer or a ninth
pointer argument.

For gnu_ilp32, zero-extend pointer arguments (in registers and on the
stack) and pointer call results instead of asserting that they are already
zero-extended. arm64_32 is unchanged.

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
---
 .../Target/AArch64/AArch64ISelLowering.cpp    |  12 +-
 llvm/lib/Target/AArch64/AArch64Subtarget.h    |   7 +
 .../AArch64/ilp32-gnu-pointer-extend.ll       | 174 ++++++++++++++++++
 3 files changed, 192 insertions(+), 1 deletion(-)
 create mode 100644 llvm/test/CodeGen/AArch64/ilp32-gnu-pointer-extend.ll

diff --git a/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp b/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
index d8398719a..2c692380d 100644
--- a/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
+++ b/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
@@ -8799,7 +8799,9 @@ SDValue AArch64TargetLowering::LowerFormalArguments(
         }
       }
     } else {
-      if (Subtarget->isTargetILP32() && Ins[i].Flags.isPointer())
+      if (Subtarget->isTargetGNUILP32() && Ins[i].Flags.isPointer())
+        ArgValue = DAG.getZeroExtendInReg(ArgValue, DL, MVT::i32);
+      else if (Subtarget->isTargetILP32() && Ins[i].Flags.isPointer())
         ArgValue = DAG.getNode(ISD::AssertZext, DL, ArgValue.getValueType(),
                                ArgValue, DAG.getValueType(MVT::i32));
 
@@ -10370,6 +10372,14 @@ AArch64TargetLowering::LowerCall(CallLoweringInfo &CLI,
       Chain, InGlue, CallConv, IsVarArg, RVLocs, DL, DAG, InVals, IsThisReturn,
       IsThisReturn ? OutVals[0] : SDValue(), RequiresSMChange);
 
+  // A GNU ILP32 callee may return a pointer with garbage in the upper 32 bits.
+  if (Subtarget->isTargetGNUILP32()) {
+    assert(InVals.size() == Ins.size() && "unexpected call result split");
+    for (unsigned I = IsThisReturn ? 1 : 0, E = InVals.size(); I != E; ++I)
+      if (Ins[I].Flags.isPointer())
+        InVals[I] = DAG.getZeroExtendInReg(InVals[I], DL, MVT::i32);
+  }
+
   if (!Ins.empty())
     InGlue = Result.getValue(Result->getNumValues() - 1);
 
diff --git a/llvm/lib/Target/AArch64/AArch64Subtarget.h b/llvm/lib/Target/AArch64/AArch64Subtarget.h
index bd8a2d523..389b6b69b 100644
--- a/llvm/lib/Target/AArch64/AArch64Subtarget.h
+++ b/llvm/lib/Target/AArch64/AArch64Subtarget.h
@@ -320,6 +320,13 @@ public:
            TargetTriple.getEnvironment() == Triple::GNUILP32;
   }
 
+  /// GNU ILP32 follows AAPCS64: the upper 32 bits of a pointer passed or
+  /// returned in a 64-bit register (or 8-byte stack slot) are unspecified and
+  /// the receiver zero-extends it. arm64_32 has the producer do that instead.
+  bool isTargetGNUILP32() const {
+    return TargetTriple.getEnvironment() == Triple::GNUILP32;
+  }
+
   bool useAA() const override;
 
   bool addrSinkUsingGEPs() const override {
diff --git a/llvm/test/CodeGen/AArch64/ilp32-gnu-pointer-extend.ll b/llvm/test/CodeGen/AArch64/ilp32-gnu-pointer-extend.ll
new file mode 100644
index 000000000..c586d6074
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/ilp32-gnu-pointer-extend.ll
@@ -0,0 +1,174 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc -mtriple=aarch64-linux-gnu_ilp32 < %s | FileCheck %s --check-prefix=GNU
+; RUN: llc -mtriple=aarch64_be-linux-gnu_ilp32 < %s | FileCheck %s --check-prefix=GNUBE
+; RUN: llc -mtriple=arm64_32-apple-ios7.0 < %s | FileCheck %s --check-prefix=DARWIN
+
+; GNU ILP32 follows AAPCS64: the upper 32 bits of a pointer passed or returned
+; in an X register or an 8-byte stack slot are unspecified (GCC leaves them
+; as they are and zero-extends on receipt), so the receiver has to clear them
+; before using the pointer as an address. arm64_32 has the producer do it.
+
+declare ptr @give()
+declare void @take(ptr)
+
+define i32 @deref(ptr %p) {
+; GNU-LABEL: deref:
+; GNU:       // %bb.0:
+; GNU-NEXT:    mov w8, w0
+; GNU-NEXT:    ldr w0, [x8]
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: deref:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    mov w8, w0
+; GNUBE-NEXT:    ldr w0, [x8]
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: deref:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ldr w0, [x0]
+; DARWIN-NEXT:    ret
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+define i32 @deref_index(ptr %p, i32 %i) {
+; GNU-LABEL: deref_index:
+; GNU:       // %bb.0:
+; GNU-NEXT:    mov w8, w0
+; GNU-NEXT:    ldr w0, [x8, w1, sxtw #2]
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: deref_index:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    mov w8, w0
+; GNUBE-NEXT:    ldr w0, [x8, w1, sxtw #2]
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: deref_index:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ldr w0, [x0, w1, sxtw #2]
+; DARWIN-NEXT:    ret
+  %a = getelementptr inbounds i32, ptr %p, i32 %i
+  %v = load i32, ptr %a
+  ret i32 %v
+}
+
+; The ninth pointer argument is passed on the stack; GCC stores only 4 bytes
+; (at offset 4 of the 8-byte slot on big-endian).
+define i32 @deref_stack(ptr %p1, ptr %p2, ptr %p3, ptr %p4, ptr %p5, ptr %p6, ptr %p7, ptr %p8, ptr %p9) {
+; GNU-LABEL: deref_stack:
+; GNU:       // %bb.0:
+; GNU-NEXT:    ldr w8, [sp]
+; GNU-NEXT:    ldr w0, [x8]
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: deref_stack:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    ldr w8, [sp, #4]
+; GNUBE-NEXT:    ldr w0, [x8]
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: deref_stack:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ldr w8, [sp]
+; DARWIN-NEXT:    ldr w0, [x8]
+; DARWIN-NEXT:    ret
+  %v = load i32, ptr %p9
+  ret i32 %v
+}
+
+define i32 @deref_returned() {
+; GNU-LABEL: deref_returned:
+; GNU:       // %bb.0:
+; GNU-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
+; GNU-NEXT:    .cfi_def_cfa_offset 16
+; GNU-NEXT:    .cfi_offset w30, -16
+; GNU-NEXT:    bl give
+; GNU-NEXT:    mov w8, w0
+; GNU-NEXT:    ldr w0, [x8]
+; GNU-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: deref_returned:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
+; GNUBE-NEXT:    .cfi_def_cfa_offset 16
+; GNUBE-NEXT:    .cfi_offset w30, -16
+; GNUBE-NEXT:    bl give
+; GNUBE-NEXT:    mov w8, w0
+; GNUBE-NEXT:    ldr w0, [x8]
+; GNUBE-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: deref_returned:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    stp x29, x30, [sp, #-16]! ; 16-byte Folded Spill
+; DARWIN-NEXT:    .cfi_def_cfa_offset 16
+; DARWIN-NEXT:    .cfi_offset w30, -8
+; DARWIN-NEXT:    .cfi_offset w29, -16
+; DARWIN-NEXT:    bl _give
+; DARWIN-NEXT:    ldr w0, [x0]
+; DARWIN-NEXT:    ldp x29, x30, [sp], #16 ; 16-byte Folded Reload
+; DARWIN-NEXT:    ret
+  %p = call ptr @give()
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+; A received pointer is extended on entry even when it is only returned.
+define ptr @pass_through(ptr %p) {
+; GNU-LABEL: pass_through:
+; GNU:       // %bb.0:
+; GNU-NEXT:    mov w0, w0
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: pass_through:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    mov w0, w0
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: pass_through:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    ret
+  ret ptr %p
+}
+
+; Outgoing pointers are still zero-extended, which is harmless for receivers
+; that extend them again.
+define void @pass_from_i64(i64 %v) {
+; GNU-LABEL: pass_from_i64:
+; GNU:       // %bb.0:
+; GNU-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
+; GNU-NEXT:    .cfi_def_cfa_offset 16
+; GNU-NEXT:    .cfi_offset w30, -16
+; GNU-NEXT:    mov w0, w0
+; GNU-NEXT:    bl take
+; GNU-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
+; GNU-NEXT:    ret
+;
+; GNUBE-LABEL: pass_from_i64:
+; GNUBE:       // %bb.0:
+; GNUBE-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
+; GNUBE-NEXT:    .cfi_def_cfa_offset 16
+; GNUBE-NEXT:    .cfi_offset w30, -16
+; GNUBE-NEXT:    mov w0, w0
+; GNUBE-NEXT:    bl take
+; GNUBE-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
+; GNUBE-NEXT:    ret
+;
+; DARWIN-LABEL: pass_from_i64:
+; DARWIN:       ; %bb.0:
+; DARWIN-NEXT:    stp x29, x30, [sp, #-16]! ; 16-byte Folded Spill
+; DARWIN-NEXT:    .cfi_def_cfa_offset 16
+; DARWIN-NEXT:    .cfi_offset w30, -8
+; DARWIN-NEXT:    .cfi_offset w29, -16
+; DARWIN-NEXT:    mov w0, w0
+; DARWIN-NEXT:    bl _take
+; DARWIN-NEXT:    ldp x29, x30, [sp], #16 ; 16-byte Folded Reload
+; DARWIN-NEXT:    ret
+  %t = trunc i64 %v to i32
+  %p = inttoptr i32 %t to ptr
+  call void @take(ptr %p)
+  ret void
+}
-- 
