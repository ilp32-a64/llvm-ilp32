From 1973dd9e9604cdf840726f07ba7f52f1a0296d94 Mon Sep 17 00:00:00 2001
From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:27:52 +0800
Subject: [PATCH 08/10] [AArch64] GNU ILP32: do not lower arguments with
 FastISel

AArch64FastISel::fastLowerArguments() copies arguments from their registers
as they are, so at -O0 GNU ILP32 pointer arguments were used without the
zero extension that LowerFormalArguments adds (their upper 32 bits are
unspecified under AAPCS64). Leave the arguments of GNU ILP32 functions to
SelectionDAG.

Signed-off-by: liviyifan <344781483+liviyifan@users.noreply.github.com>
---
 llvm/lib/Target/AArch64/AArch64FastISel.cpp     |  5 +++++
 .../CodeGen/AArch64/ilp32-gnu-fastisel-args.ll  | 17 +++++++++++++++++
 2 files changed, 22 insertions(+)
 create mode 100644 llvm/test/CodeGen/AArch64/ilp32-gnu-fastisel-args.ll

diff --git a/llvm/lib/Target/AArch64/AArch64FastISel.cpp b/llvm/lib/Target/AArch64/AArch64FastISel.cpp
index 0246c7454..a12583dc1 100644
--- a/llvm/lib/Target/AArch64/AArch64FastISel.cpp
+++ b/llvm/lib/Target/AArch64/AArch64FastISel.cpp
@@ -2898,6 +2898,11 @@ bool AArch64FastISel::fastLowerArguments() {
   if (!FuncInfo.CanLowerReturn)
     return false;
 
+  // GNU ILP32 pointer arguments must be zero-extended by the callee; leave
+  // that to SelectionDAG.
+  if (Subtarget->isTargetGNUILP32())
+    return false;
+
   const Function *F = FuncInfo.Fn;
   if (F->isVarArg())
     return false;
diff --git a/llvm/test/CodeGen/AArch64/ilp32-gnu-fastisel-args.ll b/llvm/test/CodeGen/AArch64/ilp32-gnu-fastisel-args.ll
new file mode 100644
index 000000000..0ff453877
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/ilp32-gnu-fastisel-args.ll
@@ -0,0 +1,17 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc -O0 -mtriple=aarch64-linux-gnu_ilp32 < %s | FileCheck %s
+
+; At -O0 FastISel would take the arguments as they are, but the callee must
+; zero-extend GNU ILP32 pointer arguments: SelectionDAG lowers them.
+
+define i32 @deref(ptr %p) {
+; CHECK-LABEL: deref:
+; CHECK:       // %bb.0:
+; CHECK-NEXT:    mov w8, w0
+; CHECK-NEXT:    mov w8, w8
+; CHECK-NEXT:    // kill: def $x8 killed $w8
+; CHECK-NEXT:    ldr w0, [x8]
+; CHECK-NEXT:    ret
+  %v = load i32, ptr %p
+  ret i32 %v
+}
