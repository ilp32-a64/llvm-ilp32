+  %p = getelementptr i8, ptr %b, i32 -4
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+; base: a pointer loaded from memory (32-bit load, zero-extended)
+define i32 @loaded(ptr %pp) {
+; FOLD-LABEL: loaded:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    mov w8, w0
+; FOLD-NEXT:    ldr w8, [x8]
+; FOLD-NEXT:    ldr w0, [x8, #8]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: loaded:
