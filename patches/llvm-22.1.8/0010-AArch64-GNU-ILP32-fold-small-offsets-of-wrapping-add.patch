+  %p = getelementptr i8, ptr %b, i32 %i
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+; a loop with a pointer induction variable, like LSR output
+define i32 @loop(ptr %a, i32 %n) {
+; FOLD-LABEL: loop:
+; FOLD:       // %bb.0: // %entry
+; FOLD-NEXT:    mov x8, x0
+; FOLD-NEXT:    mov w0, wzr
+; FOLD-NEXT:    mov w8, w8
+; FOLD-NEXT:  .LBB7_1: // %body
+; FOLD-NEXT:    // =>This Inner Loop Header: Depth=1
+; FOLD-NEXT:    ldp w9, w10, [x8, #-4]
+; FOLD-NEXT:    subs w1, w1, #1
+; FOLD-NEXT:    add w8, w8, #4
+; FOLD-NEXT:    add w9, w9, w10
+; FOLD-NEXT:    add w0, w0, w9
+; FOLD-NEXT:    b.ne .LBB7_1
+; FOLD-NEXT:  // %bb.2: // %exit
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: loop:
+; FOLDBE:       // %bb.0: // %entry
+; FOLDBE-NEXT:    mov x8, x0
+; FOLDBE-NEXT:    mov w0, wzr
+; FOLDBE-NEXT:    mov w8, w8
+; FOLDBE-NEXT:  .LBB7_1: // %body
+; FOLDBE-NEXT:    // =>This Inner Loop Header: Depth=1
+; FOLDBE-NEXT:    ldp w9, w10, [x8, #-4]
+; FOLDBE-NEXT:    subs w1, w1, #1
+; FOLDBE-NEXT:    add w8, w8, #4
+; FOLDBE-NEXT:    add w9, w9, w10
+; FOLDBE-NEXT:    add w0, w0, w9
+; FOLDBE-NEXT:    b.ne .LBB7_1
+; FOLDBE-NEXT:  // %bb.2: // %exit
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: loop:
+; NOFOLD:       // %bb.0: // %entry
+; NOFOLD-NEXT:    mov x8, x0
+; NOFOLD-NEXT:    mov w0, wzr
+; NOFOLD-NEXT:    mov w8, w8
+; NOFOLD-NEXT:  .LBB7_1: // %body
+; NOFOLD-NEXT:    // =>This Inner Loop Header: Depth=1
+; NOFOLD-NEXT:    sub w9, w8, #4
+; NOFOLD-NEXT:    ldr w10, [x8]
+; NOFOLD-NEXT:    subs w1, w1, #1
+; NOFOLD-NEXT:    ldr w9, [x9]
+; NOFOLD-NEXT:    add w8, w8, #4
+; NOFOLD-NEXT:    add w10, w0, w10
+; NOFOLD-NEXT:    add w0, w10, w9
+; NOFOLD-NEXT:    b.ne .LBB7_1
+; NOFOLD-NEXT:  // %bb.2: // %exit
+; NOFOLD-NEXT:    ret
+entry:
+  br label %body
+body:
+  %iv = phi ptr [ %a, %entry ], [ %iv.next, %body ]
+  %i = phi i32 [ 0, %entry ], [ %i.next, %body ]
+  %s = phi i32 [ 0, %entry ], [ %s.next, %body ]
+  %p0 = getelementptr i8, ptr %iv, i32 -4
+  %v0 = load i32, ptr %p0
+  %v1 = load i32, ptr %iv
+  %t = add i32 %v0, %v1
+  %s.next = add i32 %s, %t
+  %iv.next = getelementptr i8, ptr %iv, i32 4
+  %i.next = add i32 %i, 1
+  %c = icmp ne i32 %i.next, %n
+  br i1 %c, label %body, label %exit
+exit:
+  ret i32 %s.next
+}
+
+; two adjacent fields through a non-inbounds GEP: may pair into ldp
+define i32 @pair(ptr %b) {
+; FOLD-LABEL: pair:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    mov w8, w0
+; FOLD-NEXT:    ldp w9, w8, [x8, #8]
+; FOLD-NEXT:    add w0, w9, w8
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: pair:
+; FOLDBE:       // %bb.0:
+; FOLDBE-NEXT:    mov w8, w0
+; FOLDBE-NEXT:    ldp w9, w8, [x8, #8]
+; FOLDBE-NEXT:    add w0, w9, w8
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: pair:
+; NOFOLD:       // %bb.0:
+; NOFOLD-NEXT:    add w8, w0, #8
+; NOFOLD-NEXT:    add w9, w0, #12
+; NOFOLD-NEXT:    ldr w8, [x8]
+; NOFOLD-NEXT:    ldr w9, [x9]
+; NOFOLD-NEXT:    add w0, w8, w9
+; NOFOLD-NEXT:    ret
+  %p0 = getelementptr i8, ptr %b, i32 8
+  %p1 = getelementptr i8, ptr %b, i32 12
+  %v0 = load i32, ptr %p0
+  %v1 = load i32, ptr %p1
+  %s = add i32 %v0, %v1
+  ret i32 %s
+}
