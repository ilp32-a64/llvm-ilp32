+; The largest offsets that are folded, and the smallest that are not.
+define i32 @off_4095(ptr %pp) {
+; FOLD-LABEL: off_4095:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    mov w8, w0
+; FOLD-NEXT:    ldr w8, [x8]
+; FOLD-NEXT:    add x8, x8, #4095
+; FOLD-NEXT:    ldr w0, [x8]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: off_4095:
+; FOLDBE:       // %bb.0:
+; FOLDBE-NEXT:    mov w8, w0
+; FOLDBE-NEXT:    ldr w8, [x8]
+; FOLDBE-NEXT:    add x8, x8, #4095
+; FOLDBE-NEXT:    ldr w0, [x8]
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: off_4095:
+; NOFOLD:       // %bb.0:
