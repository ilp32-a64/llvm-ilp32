+; FOLDBE-NEXT:    add w8, w0, #1, lsl #12 // =4096
+; FOLDBE-NEXT:    ldr w0, [x8]
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: big_offset:
+; NOFOLD:       // %bb.0:
+; NOFOLD-NEXT:    add w8, w0, #1, lsl #12 // =4096
+; NOFOLD-NEXT:    ldr w0, [x8]
+; NOFOLD-NEXT:    ret
+  %p = getelementptr i8, ptr %b, i32 4096
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+; must not change: variable offset
+define i32 @var_offset(ptr %b, i32 %i) {
+; FOLD-LABEL: var_offset:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    add w8, w0, w1
+; FOLD-NEXT:    ldr w0, [x8]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: var_offset:
+; FOLDBE:       // %bb.0:
+; FOLDBE-NEXT:    add w8, w0, w1
+; FOLDBE-NEXT:    ldr w0, [x8]
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: var_offset:
+; NOFOLD:       // %bb.0:
+; NOFOLD-NEXT:    add w8, w0, w1
+; NOFOLD-NEXT:    ldr w0, [x8]
