+
+; GNU ILP32 on Linux: an address computed modulo 2^32 by a GEP without inbounds,
+; zext(Base + C1) + C2, is used as zext(Base) + (C1 + C2) when C1 and C2 do not
+; have opposite signs and |C1 + C2| is less than a page: the two differ only for
+; a Base within |C1| of 0 or 4 GiB, where the access faults either way (C1 > 0)
+; or Base is not a valid pointer (C1 < 0). Pointers read from other blocks are
+; known to be zero-extended, so that loop bases are free.
+
+
+; base: a pointer argument (zero-extended on entry)
+define i32 @arg_pos(ptr %b) {
+; FOLD-LABEL: arg_pos:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    mov w8, w0
+; FOLD-NEXT:    ldr w0, [x8, #12]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: arg_pos:
+; FOLDBE:       // %bb.0:
+; FOLDBE-NEXT:    mov w8, w0
+; FOLDBE-NEXT:    ldr w0, [x8, #12]
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: arg_pos:
+; NOFOLD:       // %bb.0:
+; NOFOLD-NEXT:    add w8, w0, #12
+; NOFOLD-NEXT:    ldr w0, [x8]
+; NOFOLD-NEXT:    ret
+  %p = getelementptr i8, ptr %b, i32 12
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+define i32 @arg_neg(ptr %b) {
+; FOLD-LABEL: arg_neg:
