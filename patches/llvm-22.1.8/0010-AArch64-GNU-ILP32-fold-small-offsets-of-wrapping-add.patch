diff --git a/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp b/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
index ccfaab579..dac367d35 100644
--- a/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
+++ b/llvm/lib/Target/AArch64/AArch64ISelLowering.cpp
@@ -125,6 +125,12 @@ EnableOptimizeLogicalImm("aarch64-enable-logical-imm", cl::Hidden,
                                   "optimization"),
                          cl::init(true));
 
+static cl::opt<bool> FoldILP32AddressOffsets(
+    "aarch64-ilp32-fold-address-offsets", cl::Hidden, cl::init(true),
+    cl::desc("GNU ILP32: fold constant offsets of less than a page into the "
+             "address of a load or store even if the 32-bit address "
+             "computation may wrap"));
+
 // Temporary option added for the purpose of testing functionality added
 // to DAGCombiner.cpp in D92230. It is expected that this can be removed
 // in future when both implementations will be based off MGATHER rather
@@ -24936,6 +24942,99 @@ static SDValue combineV3I8LoadExt(LoadSDNode *LD, SelectionDAG &DAG) {
   return DAG.getMergeValues({Extract, TokenFactor}, DL);
 }
 
+/// Whether a 32-bit value is produced by an instruction that writes a W
+/// register, so that zero-extending it to 64 bits is free (as isDef32 in
+/// AArch64ISelDAGToDAG.cpp).
+static bool isDef32(SDValue N) {
+  unsigned Opc = N.getOpcode();
+  return N.getValueType() == MVT::i32 && Opc != ISD::TRUNCATE &&
+         Opc != TargetOpcode::EXTRACT_SUBREG && Opc != ISD::CopyFromReg &&
+         Opc != ISD::AssertSext && Opc != ISD::AssertZext &&
+         Opc != ISD::AssertAlign && Opc != ISD::FREEZE;
+}
+
+/// Whether every use of Ptr is as the address of a simple load or store.
+static bool isOnlyUsedAsAddress(SDValue Ptr) {
+  for (SDUse &U : Ptr->uses()) {
+    auto *Mem = dyn_cast<LSBaseSDNode>(U.getUser());
+    if (!Mem || !Mem->isSimple() || !Mem->isUnindexed() ||
+        U.getOperandNo() != (isa<StoreSDNode>(Mem) ? 2u : 1u))
+      return false;
+  }
+  return true;
+}
+
+/// GNU ILP32 on Linux: a load or store address computed modulo 2^32,
+/// zext(Base + C1) + C2, is replaced by zext(Base) + (C1 + C2), which the
+/// addressing modes can absorb, when C1 and C2 are constants that do not have
+/// opposite signs and |C1 + C2| is less than a page. C2, usually 0, is added
+/// after the extension, e.g. by load narrowing. The two addresses differ only
+/// when Base is within |C1| of 0 or 2^32: for C1 > 0 both are unmapped (the
+/// first page, and the space above the 4 GiB address space of an ILP32
+/// process), so both accesses fault; for C1 < 0 Base is in the first page and
+/// not a valid pointer. GCC folds such offsets the same way.
+static SDValue foldILP32AddressOffset(SDNode *N,
+                                      TargetLowering::DAGCombinerInfo &DCI,
+                                      SelectionDAG &DAG,
+                                      const AArch64Subtarget *Subtarget) {
+  if (!FoldILP32AddressOffsets || !Subtarget->isTargetGNUILP32() ||
+      !Subtarget->isTargetLinux())
+    return SDValue();
+  auto *Mem = cast<LSBaseSDNode>(N);
+  if (!Mem->isSimple() || !Mem->isUnindexed())
+    return SDValue();
+  SDValue Ptr = Mem->getBasePtr();
+  SDValue Ext = Ptr;
+  int64_t OuterOffset = 0;
+  if (DAG.isBaseWithConstantOffset(Ptr)) {
+    Ext = Ptr.getOperand(0);
+    OuterOffset = cast<ConstantSDNode>(Ptr.getOperand(1))->getSExtValue();
+  }
+  if (Ext.getOpcode() != ISD::ZERO_EXTEND || Ext.getValueType() != MVT::i64)
+    return SDValue();
+  SDValue Addr = Ext.getOperand(0);
+  if (Addr.getValueType() != MVT::i32 || !DAG.isBaseWithConstantOffset(Addr))
+    return SDValue();
+  int64_t InnerOffset =
+      cast<ConstantSDNode>(Addr.getOperand(1))->getSExtValue();
+  if (OuterOffset <= -4096 || OuterOffset >= 4096 ||
+      (InnerOffset < 0 && OuterOffset > 0) ||
+      (InnerOffset > 0 && OuterOffset < 0))
+    return SDValue();
+  int64_t Offset = InnerOffset + OuterOffset;
+  if (Offset <= -4096 || Offset >= 4096)
+    return SDValue();
+
+  SDLoc DL(N);
+  SDValue Base = Addr.getOperand(0);
+  SDValue Base64;
+  if (Base.getOpcode() == ISD::TRUNCATE &&
+      Base.getOperand(0).getValueType() == MVT::i64 &&
+      DAG.computeKnownBits(Base.getOperand(0)).countMinLeadingZeros() >= 32)
+    Base64 = Base.getOperand(0);
+  else if (isDef32(Base) ||
+           (Addr.hasOneUse() && (Ext == Ptr || Ext.hasOneUse()) &&
+            isOnlyUsedAsAddress(Ptr)))
+    // Free, or paid for by the 32-bit address computation that goes away.
+    Base64 = DAG.getNode(ISD::ZERO_EXTEND, DL, MVT::i64, Base);
+  else
+    return SDValue();
+  SDValue NewPtr = DAG.getNode(ISD::ADD, DL, MVT::i64, Base64,
+                               DAG.getSignedConstant(Offset, DL, MVT::i64));
+
+  if (auto *LD = dyn_cast<LoadSDNode>(N)) {
+    SDValue NewLD = DAG.getLoad(ISD::UNINDEXED, LD->getExtensionType(),
+                                LD->getValueType(0), DL, LD->getChain(), NewPtr,
+                                LD->getOffset(), LD->getMemoryVT(),
+                                LD->getMemOperand());
+    return DCI.CombineTo(N, NewLD, NewLD.getValue(1));
+  }
+  auto *ST = cast<StoreSDNode>(N);
+  return DAG.getStore(ST->getChain(), DL, ST->getValue(), NewPtr,
+                      ST->getOffset(), ST->getMemoryVT(), ST->getMemOperand(),
+                      ISD::UNINDEXED, ST->isTruncatingStore());
+}
+
 // Perform TBI simplification if supported by the target and try to break up
 // nontemporal loads larger than 256-bits loads for odd types so LDNPQ 256-bit
 // load instructions can be selected.
@@ -28542,8 +28641,12 @@ SDValue AArch64TargetLowering::PerformDAGCombine(SDNode *N,
   case ISD::SETCC:
     return performSETCCCombine(N, DCI, DAG);
   case ISD::LOAD:
+    if (SDValue Res = foldILP32AddressOffset(N, DCI, DAG, Subtarget))
+      return Res;
     return performLOADCombine(N, DCI, DAG, Subtarget);
   case ISD::STORE:
+    if (SDValue Res = foldILP32AddressOffset(N, DCI, DAG, Subtarget))
+      return Res;
     return performSTORECombine(N, DCI, DAG, Subtarget);
   case ISD::MSTORE:
     return performMSTORECombine(N, DCI, DAG, Subtarget);
