+; NOFOLD-NEXT:    ldr w0, [x8]
+; NOFOLD-NEXT:    ret
+  %b = load ptr, ptr %pp
+  %p = getelementptr i8, ptr %b, i32 8
+  %v = load i32, ptr %p
+  ret i32 %v
+}
+
+; store to a wrapped address, and store of the wrapped address itself
+define void @store_addr_and_value(ptr %b, ptr %out) {
+; FOLD-LABEL: store_addr_and_value:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    mov w8, #7 // =0x7
+; FOLD-NEXT:    add w9, w0, #16
+; FOLD-NEXT:    mov w10, w1
+; FOLD-NEXT:    str w8, [x9]
+; FOLD-NEXT:    str w9, [x10]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: store_addr_and_value:
+; FOLDBE:       // %bb.0:
+; FOLDBE-NEXT:    mov w8, #7 // =0x7
+; FOLDBE-NEXT:    add w9, w0, #16
+; FOLDBE-NEXT:    mov w10, w1
+; FOLDBE-NEXT:    str w8, [x9]
+; FOLDBE-NEXT:    str w9, [x10]
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: store_addr_and_value:
+; NOFOLD:       // %bb.0:
+; NOFOLD-NEXT:    mov w8, #7 // =0x7
+; NOFOLD-NEXT:    add w9, w0, #16
+; NOFOLD-NEXT:    mov w10, w1
+; NOFOLD-NEXT:    str w8, [x9]
+; NOFOLD-NEXT:    str w9, [x10]
+; NOFOLD-NEXT:    ret
+  %p = getelementptr i8, ptr %b, i32 16
+  store i32 7, ptr %p
+  store ptr %p, ptr %out
+  ret void
+}
+
+; must not change: volatile access
+define i32 @volatile_load(ptr %b) {
+; FOLD-LABEL: volatile_load:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    add w8, w0, #12
+; FOLD-NEXT:    ldr w0, [x8]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: volatile_load:
+; FOLDBE:       // %bb.0:
+; FOLDBE-NEXT:    add w8, w0, #12
+; FOLDBE-NEXT:    ldr w0, [x8]
+; FOLDBE-NEXT:    ret
+;
+; NOFOLD-LABEL: volatile_load:
+; NOFOLD:       // %bb.0:
+; NOFOLD-NEXT:    add w8, w0, #12
+; NOFOLD-NEXT:    ldr w0, [x8]
+; NOFOLD-NEXT:    ret
+  %p = getelementptr i8, ptr %b, i32 12
+  %v = load volatile i32, ptr %p
+  ret i32 %v
+}
+
+; must not change: offset of a page or more
+define i32 @big_offset(ptr %b) {
+; FOLD-LABEL: big_offset:
+; FOLD:       // %bb.0:
+; FOLD-NEXT:    add w8, w0, #1, lsl #12 // =4096
+; FOLD-NEXT:    ldr w0, [x8]
+; FOLD-NEXT:    ret
+;
+; FOLDBE-LABEL: big_offset:
