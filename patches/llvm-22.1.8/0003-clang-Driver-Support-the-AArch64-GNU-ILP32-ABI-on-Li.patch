+++ b/clang/lib/Driver/ToolChains/CommonArgs.cpp
@@ -576,10 +576,14 @@ const char *tools::getLDMOption(const llvm::Triple &T, const ArgList &Args) {
       return "aarch64managarm";
     else if (aarch64::isAArch64BareMetal(T))
       return "aarch64elf";
+    if (T.getEnvironment() == llvm::Triple::GNUILP32)
