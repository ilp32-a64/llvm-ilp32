   case llvm::Triple::aarch64_be:
+    if (TargetEnvironment == llvm::Triple::GNUILP32)
+      return "aarch64_be-linux-gnu_ilp32";
     return "aarch64_be-linux-gnu";
 
   case llvm::Triple::loongarch64: {
@@ -203,6 +207,10 @@ static StringRef getOSLibDir(const llvm::Triple &Triple, const ArgList &Args) {
   if (Triple.getArch() == llvm::Triple::x86_64 && Triple.isX32())
     return "libx32";
 
+  if (Triple.isAArch64() &&
+      Triple.getEnvironment() == llvm::Triple::GNUILP32)
+    return "libilp32";
+
   if (Triple.getArch() == llvm::Triple::riscv32)
     return "lib32";
 
@@ -615,11 +623,15 @@ std::string Linux::getDynamicLinker(const ArgList &Args) const {
 
   case llvm::Triple::aarch64:
