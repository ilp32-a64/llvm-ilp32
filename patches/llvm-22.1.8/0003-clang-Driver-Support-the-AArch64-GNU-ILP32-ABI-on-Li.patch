diff --git a/clang/lib/Driver/Driver.cpp b/clang/lib/Driver/Driver.cpp
index eb3f9cbea..461b2190e 100644
--- a/clang/lib/Driver/Driver.cpp
+++ b/clang/lib/Driver/Driver.cpp
@@ -791,6 +791,22 @@ static llvm::Triple computeTargetTriple(const Driver &D,
     }
   }
 
+  // If target is AArch64 GNU/Linux adjust the target triple according to the
+  // provided ABI name, as GCC does for -mabi=ilp32 and -mabi=lp64.
+  if ((Target.getArch() == llvm::Triple::aarch64 ||
+       Target.getArch() == llvm::Triple::aarch64_be) &&
+      Target.isOSLinux()) {
+    if ((A = Args.getLastArgNoClaim(options::OPT_mabi_EQ))) {
+      StringRef ABIName = A->getValue();
+      if (ABIName == "ilp32" &&
+          Target.getEnvironment() == llvm::Triple::GNU)
+        Target.setEnvironment(llvm::Triple::GNUILP32);
+      else if (ABIName == "lp64" &&
+               Target.getEnvironment() == llvm::Triple::GNUILP32)
+        Target.setEnvironment(llvm::Triple::GNU);
+    }
+  }
+
   // If target is RISC-V adjust the target triple according to
   // provided architecture name
   if (Target.isRISCV()) {
