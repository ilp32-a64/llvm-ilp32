index d525b417b..29e8aba5e 100644
--- a/clang/lib/Driver/ToolChains/Linux.cpp
+++ b/clang/lib/Driver/ToolChains/Linux.cpp
@@ -88,8 +88,12 @@ std::string Linux::getMultiarchTriple(const Driver &D,
     if (hasEffectiveTriple() &&
         getEffectiveTriple().getEnvironment() == llvm::Triple::PAuthTest)
       return "aarch64-linux-pauthtest";
+    if (TargetEnvironment == llvm::Triple::GNUILP32)
