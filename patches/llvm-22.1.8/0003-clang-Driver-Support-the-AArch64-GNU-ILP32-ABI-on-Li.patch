+// Check the driver support for the AArch64 GNU ILP32 ABI, laid out like a GCC
+// aarch64-linux-gnu_ilp32 toolchain (libraries in libilp32).
+
+// RUN: %clang -### %s --target=aarch64-linux-gnu_ilp32 -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_linux_gnu_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32
+// RUN: %clang -### %s --target=aarch64-linux-gnu -mabi=ilp32 -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_linux_gnu_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32
+// ILP32: "-cc1" "-triple" "aarch64-unknown-linux-gnu_ilp32"
+// ILP32-SAME: "-target-abi" "aapcs"
+// ILP32: "--sysroot=[[SYSROOT:[^"]+]]"
+// ILP32-SAME: "-m" "aarch64linux32"
+// ILP32-SAME: "-dynamic-linker" "/lib/ld-linux-aarch64_ilp32.so.1"
+// ILP32-SAME: "[[SYSROOT]]/usr/lib/gcc/aarch64-linux-gnu_ilp32/10.5.0/../../../../libilp32{{/|\\\\}}crt1.o"
+// ILP32-SAME: "[[SYSROOT]]/usr/lib/gcc/aarch64-linux-gnu_ilp32/10.5.0{{/|\\\\}}crtbegin.o"
+// ILP32-SAME: "-L[[SYSROOT]]/usr/lib/gcc/aarch64-linux-gnu_ilp32/10.5.0"
+// ILP32-SAME: "-L[[SYSROOT]]/usr/lib/gcc/aarch64-linux-gnu_ilp32/10.5.0/../../../../libilp32"
+// ILP32-SAME: "-L[[SYSROOT]]/lib/../libilp32"
+// ILP32-SAME: "-L[[SYSROOT]]/usr/libilp32"
+
+// RUN: %clang -### %s --target=aarch64_be-linux-gnu_ilp32 -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_linux_gnu_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32BE
+// RUN: %clang -### %s --target=aarch64-linux-gnu_ilp32 -mbig-endian -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_linux_gnu_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=ILP32BE
+// ILP32BE: "-cc1" "-triple" "aarch64_be-unknown-linux-gnu_ilp32"
+// ILP32BE: "-m" "aarch64linux32b"
+// ILP32BE-SAME: "-dynamic-linker" "/lib/ld-linux-aarch64_be_ilp32.so.1"
+// ILP32BE-SAME: "-L{{[^"]+}}/usr/libilp32"
+
+// -mabi=lp64 selects the LP64 ABI again.
+// RUN: %clang -### %s --target=aarch64-linux-gnu_ilp32 -mabi=lp64 -no-pie \
+// RUN:     --sysroot=%S/Inputs/aarch64_linux_gnu_ilp32_tree \
+// RUN:     -rtlib=platform --unwindlib=platform 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=LP64 --implicit-check-not=libilp32 \
+// RUN:       --implicit-check-not=_ilp32.so
+// LP64: "-cc1" "-triple" "aarch64-unknown-linux-gnu"
+// LP64-SAME: "-target-abi" "aapcs"
+// LP64: "-m" "aarch64linux"
+// LP64-SAME: "-dynamic-linker" "/lib/ld-linux-aarch64.so.1"
